
# ==================================================
# AgriRent Hub
# Root Git Ignore Configuration
# Spring Boot + Node.js + Frontend + ML
# ==================================================

# ---------- Security: Secrets and Credentials ----------
.env
.env.*
!.env.example
!.env.template

**/secrets/
**/credentials/
**/credentials.json
**/service-account*.json
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*.jks

# Spring Boot configuration (may contain passwords)
**/application.properties
**/application-*.properties

# ---------- Java / Maven / Spring Boot ----------
**/target/
**/build/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*

# ---------- Node.js / npm ----------
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

.npm/
.pnpm-store/
.yarn/cache/

# ---------- Frontend Build Artifacts ----------
**/dist/
**/coverage/
**/.next/
**/out/
**/.cache/
.nyc_output/

# ---------- Python / Machine Learning ----------
**/__pycache__/
**/*.py[cod]
**/.venv/
**/venv/
**/ENV/
**/.pytest_cache/
**/.mypy_cache/
**/.ruff_cache/
**/.ipynb_checkpoints/

# Python packaging
**/*.egg-info/
**/wheels/

# Generated ML models (review before ignoring)
**/*.pkl
**/*.pickle
**/*.joblib
**/*.onnx
**/*.pt
**/*.pth
**/*.h5
**/*.keras
**/checkpoints/

# ---------- Databases and Local Data ----------
**/*.sqlite
**/*.sqlite3
**/*.db
**/*.mv.db

# ---------- Logs and Temporary Files ----------
*.log
**/logs/
*.tmp
*.temp
*.swp
*.swo
*.bak

# ---------- IDE Configuration ----------
.idea/
.vscode/
*.iml
.project
.classpath
.settings/

# ---------- Operating System ----------
.DS_Store
Thumbs.db
Desktop.ini

# ---------- Test Reports ----------
**/surefire-reports/
**/failsafe-reports/
# User uploaded files and personal data
uploads/